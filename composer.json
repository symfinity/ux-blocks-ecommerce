{
    "name": "symfinity/ux-blocks-ecommerce",
    "description": "Symfinity UX Blocks Ecommerce — shop section catalog with blocks.shop fragments",
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2",
        "symfinity/ux-blocks-core": "^0.1",
        "symfony/framework-bundle": "^7.4||^8.0",
        "symfony/stimulus-bundle": "^2.0|^3.0",
        "symfony/twig-bundle": "^7.4||^8.0",
        "symfony/ux-twig-component": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "symfony/browser-kit": "^7.4||^8.0",
        "symfony/css-selector": "^7.4||^8.0",
        "symfony/yaml": "^7.4||^8.0"
    },
    "suggest": {
        "symfinity/ux-blocks-marketing": "Optional landing cross-sell sections"
    },
    "autoload": {
        "psr-4": {
            "Symfinity\\UxBlocksEcommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfinity\\UxBlocksEcommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "0.1.0-dev",
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}

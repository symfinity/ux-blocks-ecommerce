<section
    data-ui-role="shopping-cart-layout"
    data-ui-fragment="blocks.shop.shopping-cart-layout"
    {{ attributes }}
>
    {% if items|length == 0 %}
        <p>{{ emptyMessage }}</p>
    {% else %}
        <ul>
            {% for item in items %}
                <li>
                    {% if item.imageUrl %}<img src="{{ item.imageUrl }}" alt="" />{% endif %}
                    {% if item.href %}
                        <a href="{{ item.href }}">{{ item.label }}</a>
                    {% else %}
                        <span>{{ item.label }}</span>
                    {% endif %}
                    <span data-ui-role="quantity">{{ item.quantity }}</span>
                    <span data-ui-role="unit-price">{{ item.unitPrice }}</span>
                    {% if item.lineTotal %}<span data-ui-role="line-total">{{ item.lineTotal }}</span>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    {% block content %}{% endblock %}
</section>
